{
  "name": "turnday",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "test": "pnpm -r --if-present test",
    "test:matrix": "pnpm --filter @turnday/domain exec vitest run --reporter=default --reporter=json --outputFile=../../reports/vitest-domain.json && node tools/traceability/src/cli.ts reports/vitest-domain.json",
    "verify": "pnpm lint && pnpm typecheck && pnpm arch && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
