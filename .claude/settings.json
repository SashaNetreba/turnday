{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm verify)",
      "Bash(pnpm arch)",
      "Bash(pnpm test:matrix)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(ls *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(docker *)",
      "Bash(pnpm dlx *)",
      "Bash(npx *)",
      "Bash(pnpm add *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git *--no-verify*)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*guest-list-report*.csv)",
      "Read(./private/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.js"
          }
        ]
      }
    ]
  }
}
